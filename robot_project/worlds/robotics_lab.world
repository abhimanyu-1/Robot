<?xml version="1.0"?>
<sdf version="1.6">
  <world name="robotics_lab">

    <!-- ============================================================ -->
    <!--  ENVIRONMENT & RENDERING                                     -->
    <!-- ============================================================ -->

    <scene>
      <ambient>0.55 0.55 0.6 1.0</ambient>
      <background>0.85 0.88 0.92 1.0</background>
      <shadows>true</shadows>
      <sky>
        <time>11.5</time>
        <sunrise>6.0</sunrise>
        <sunset>18.0</sunset>
        <clouds>
          <speed>5</speed>
          <humidity>0.3</humidity>
        </clouds>
      </sky>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-4.2 -4.8 4.2 0 0.58 0.78</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ============================================================ -->
    <!--  LIGHTING SYSTEM                                             -->
    <!-- ============================================================ -->

    <!-- Primary overhead directional (sun substitute) -->
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.95 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -0.9</direction>
    </light>

    <!-- Ceiling spot lights for laboratory illumination -->
    <light name='ceiling_spot_1' type='point'>
      <pose>-2.5 2.5 3.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name='ceiling_spot_2' type='point'>
      <pose>2.5 2.5 3.8 0 0 0</pose>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name='ceiling_spot_3' type='point'>
      <pose>-2.5 -2.5 3.8 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name='ceiling_spot_4' type='point'>
      <pose>2.5 -2.5 3.8 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>12</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Accent strip light along east wall -->
    <light name='accent_east' type='spot'>
      <pose>4.6 0 3.2 0 0.6 -1.57</pose>
      <diffuse>0.3 0.5 0.9 1</diffuse>
      <specular>0.1 0.2 0.4 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0.8</inner_angle>
        <outer_angle>1.5</outer_angle>
        <falloff>1.0</falloff>
      </spot>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============================================================ -->
    <!--  FLOOR                                                       -->
    <!-- ============================================================ -->

    <!-- Industrial epoxy floor with subtle grid pattern -->
    <model name="lab_floor">
      <static>true</static>
      <link name="floor_link">
        <pose>0 0 0 0 0 0</pose>
        <collision name="floor_col">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
        </collision>
        <visual name="floor_vis">
          <geometry><plane><normal>0 0 1</normal><size>12 12</size></plane></geometry>
          <material>
            <ambient>0.35 0.37 0.40 1</ambient>
            <diffuse>0.42 0.44 0.48 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Floor safety markings - yellow boundary line -->
    <model name="safety_line_north">
      <static>true</static>
      <link name="link">
        <pose>0 4.3 0.002 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>8.0 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
            <emissive>0.15 0.13 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="safety_line_south">
      <static>true</static>
      <link name="link">
        <pose>0 -4.3 0.002 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>8.0 0.08 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
            <emissive>0.15 0.13 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="safety_line_east">
      <static>true</static>
      <link name="link">
        <pose>4.3 0 0.002 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.08 8.0 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
            <emissive>0.15 0.13 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>
    <model name="safety_line_west">
      <static>true</static>
      <link name="link">
        <pose>-4.3 0 0.002 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>0.08 8.0 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
            <emissive>0.15 0.13 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot starting pad - green circle marker -->
    <model name="start_pad">
      <static>true</static>
      <link name="link">
        <pose>-1.0 -1.0 0.003 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.4</radius><length>0.002</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.7 0.3 1</ambient>
            <diffuse>0.15 0.75 0.35 1</diffuse>
            <emissive>0.02 0.12 0.04 1</emissive>
          </material>
        </visual>
      </link>
    </model>


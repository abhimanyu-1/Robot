<?xml version="1.0"?>
<sdf version="1.6">
  <world name="virtual_room_world">

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Global Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>true</shadows>
    </scene>

    <!-- Camera Viewpoint -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.0 -8.5 11.5 0 0.95 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- Physics Engine -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ==================== ROOM WALLS (10m x 10m) ==================== -->
    <model name="room_walls">
      <static>true</static>

      <!-- North Wall -->
      <link name="wall_north">
        <pose>0 5 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- South Wall -->
      <link name="wall_south">
        <pose>0 -5 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>10.2 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- East Wall -->
      <link name="wall_east">
        <pose>5 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 10.0 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- West Wall -->
      <link name="wall_west">
        <pose>-5 0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.2 10.0 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.85 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Interior Divider Wall (creates room corridors) -->
      <link name="interior_divider_1">
        <pose>-1.8 2.0 0.75 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>3.6 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.6 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.6 0.65 0.7 1</ambient>
            <diffuse>0.5 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="interior_divider_2">
        <pose>2.5 -2.2 0.75 0 0 1.5708</pose>
        <collision name="col">
          <geometry><box><size>3.0 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>3.0 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.6 0.65 0.7 1</ambient>
            <diffuse>0.5 0.55 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== OBSTACLES ==================== -->

    <!-- Obstacle 1: Center Cylindrical Column -->
    <model name="center_pillar">
      <static>true</static>
      <pose>0.8 0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.45</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Large Wooden Box (North-East Room) -->
    <model name="box_large_ne">
      <static>true</static>
      <pose>2.8 2.6 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.5 0.2 1</ambient>
            <diffuse>0.8 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Medium Crate (South-West Room) -->
    <model name="box_med_sw">
      <static>true</static>
      <pose>-2.5 -2.5 0.4 0 0 -0.4</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.0 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.9 0.3 0.2 1</ambient>
            <diffuse>0.9 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 4: Small Barrel (South-East Corridor) -->
    <model name="barrel_se">
      <static>true</static>
      <pose>0.5 -3.2 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.7 0.3 1</ambient>
            <diffuse>0.2 0.7 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 5: Barrier Block (North-West Corridor) -->
    <model name="barrier_nw">
      <static>true</static>
      <pose>-3.5 0.2 0.4 0 0 0.7</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.4 0.5 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.4 0.5 0.8</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.7 1</ambient>
            <diffuse>0.7 0.2 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

